# ===== 模型服务 =====
# 复制为 .env 并按需修改；也可以直接设置系统环境变量。
# 未配置 DEEPSEEK_API_KEY 时会自动进入离线 Mock 模式，网页仍可完整体验。

# api key（必填，留空则使用 Mock）
DEEPSEEK_API_KEY=

# 接口地址（默认官方；可指向任意 OpenAI 兼容服务）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名：deepseek-flash 就是 DeepSeek-V4.1-Flash，本项目固定用它。
# 不要改成 deepseek-v4-pro —— 官方那一档不支持图像理解，而本项目全靠图片输入。
# 官方来源：https://api-docs.deepseek.com/zh-cn/quick_start/pricing
DEEPSEEK_MODEL=deepseek-flash

# auto / deepseek / mock；auto 会依据是否配置 Key 自动选择
LLM_PROVIDER=auto

# 工具调用最大轮数（防止死循环）
MAX_TOOL_ROUNDS=8

# 是否把工具交给模型（0 关闭 = 只让模型直接输出坐标，不执行 parse_coordinates / annotate_image 等）
USE_TOOLS=1

# 图片输入精度：image_url 内容块可选的 detail 字段，可选 low / high / original / auto。
#   low = 推理前把图缩到 512×512（更快、更省 token）；high / original = 保留原图；auto = 服务端自行决定。
# 留空 = **根本不发送这个字段**（本项目默认，行为与老版本一致）。
# ⚠️ 它不是"提高定位精度"的开关：官方每张图最多只算 384 token，大图照样会被缩到约 800×800。
# IMAGE_DETAIL=

# 单次请求超时（秒）
REQUEST_TIMEOUT=120

# ===== 思考模式 =====
# DeepSeek 默认先输出思维链（reasoning_content）再给正文。
# 置 0 关闭：模型直接给正文，延迟与输出 token 显著下降（实测同一问题
# completion_tokens 从 35 降到 1），代价是复杂推理准确率可能下降。
# 网页上还有一个「思考模式」开关，可按每次识别覆盖这个默认值。
THINKING=1

# 思考强度：low / medium / high / xhigh / max（留空 = 服务端默认 high）
# 仅在思考开启时生效，映射表见 docs/DeepSeek-Thinking-Mode.md
# REASONING_EFFORT=

# ===== Web 服务 =====
WEB_HOST=127.0.0.1
WEB_PORT=8765

# ===== 上传 / 历史记录（布局与 schema 见 AGENTS.md §4.9）=====
# 单张上传图片的大小上限（MB）。0 = 不限；超限直接 413 并删掉半截临时文件。
MAX_UPLOAD_MB=20

# 打标历史记录的保留条数（每条 = runs/history/<run_id>/ 下的 meta.json + annotated.png）。
# 超出后按 run_id 删最老的；0 = 不限。
HISTORY_MAX=200

# 可选：覆盖系统提示词
# SYSTEM_PROMPT=

# ===== 用户偏好（不在这个文件里，见 AGENTS.md §4.10）=====
# 网页左栏「识别参数」点过的开关会写进项目根的 config.local.json，**优先级高于本文件的环境变量**：
#     内置默认  <  环境变量(.env)  <  config.local.json  <  单次请求字段
# 能进那个文件的键：thinking / reasoning_effort / use_tools / max_tool_rounds / image_detail / prompt / system_prompt。
# 想让这里的环境变量重新生效，删掉 config.local.json 里对应的那一行（或调 DELETE /api/settings）。
# 该文件已 gitignore，本机私有，不会被提交。
